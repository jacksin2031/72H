# Non-secret local configuration. Google Cloud uses ADC, never browser API keys.
API_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLOUD_PROJECT=h-japan
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash-lite
PLANNER_MODE=deterministic
# Optional live mobility adapter: set EKISPERT_API_ACCESS_KEY in the backend
# environment (Secret Manager in production), never in browser/public config.
